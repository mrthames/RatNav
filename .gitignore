# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/

# Runtime data — caches, map images, plans, tracking, settings.
#
# Anchored to the repository root. Unanchored, this matched src/RatNav.Core/Data/ as well —
# Git matches ignore patterns case-insensitively on Windows — and silently kept the entire data
# layer out of the repository, so a fresh clone did not build.
/data/

# Local publish output
/publish/
/publish-*/
/installer-output/

# Web
node_modules/
web/dist/
src/RatNav.Service/wwwroot/
*.local

# Nothing of a player's own, ever. These live in %LOCALAPPDATA%\RatNav; a copy here would be
# somebody's stash, progress and position history in a public repository.
settings.json
tracking.json
progress.json
waypoints.json
screenshots-read.log
/plans/
gamedata-*.json

# Screenshots from the game. The filename carries world coordinates and the picture carries a stash.
*[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9][[]*.png
/screenshots/
*.local.json

# Working notes. What was asked for, when, and by whom is how this got built — it is not what
# somebody downloading it needs, and a public repository should be the product rather than the
# record of one person's requests. Kept alongside the repo, not in it.
/docs/backlog.md
/notes/

# OS
Thumbs.db
.DS_Store

# Vite build artifacts land in the service's wwwroot
web/dist/

# Coverage reports are generated by `npm run test:coverage` and are a few hundred files of HTML.
# Read them locally; they are not a record of anything.
web/coverage/
