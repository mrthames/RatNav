<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- So a detection that finds nothing can be diagnosed from a test rather than by guesswork. -->
    <InternalsVisibleTo Include="RatNav.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The Battlestate installer records where it put the game, and asking it is worth more than
      any amount of guessing at paths. This project stays net8.0 so it builds on a Mac; the
      package restores there and the one call site is guarded by OperatingSystem.IsWindows(),
      so nothing here is Windows-only to compile, only to answer.
    -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

</Project>
