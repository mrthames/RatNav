<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\RatNav.Core\RatNav.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reading a container out of a screenshot needs to open the picture. System.Drawing is Windows
      only, which RatNav already is — it reads Escape from Tarkov's own files and draws a WPF
      overlay — so this costs nothing that was not already true.
    -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <!--
    The built web app has to travel with whoever hosts the service. Without this it sits in the
    service project's own output only, and the WPF app — which hosts the service in-process —
    serves 404 for every page while the API works fine.
  -->
  <ItemGroup>
    <!--
      Both attributes are needed and they are not the same switch. CopyToOutputDirectory covers
      `dotnet build`; CopyToPublishDirectory covers `dotnet publish`. With only the first, every
      developer build serves the web app and every release download 404s on it.
    -->
    <Content Update="wwwroot\**"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
