<Window x:Class="RatNav.App.ItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RatNav — Items"
        Width="320" Height="620"
        Background="#0b0f13"
        WindowStartupLocation="CenterOwner">

    <!--
        The items list, torn off the overlay.

        This exists for the two-monitor case and for anyone who would rather keep the list up
        permanently than have it over the game. It is an ordinary window: it appears in the
        taskbar, it can be moved to another screen, and closing it puts the list back inline.
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="Line" Color="#24313b" />
        <SolidColorBrush x:Key="Ink" Color="#c9d6df" />
        <SolidColorBrush x:Key="Muted" Color="#7b8c9b" />
    </Window.Resources>

    <DockPanel Margin="10,8">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" Margin="0,0,0,8"
                   FontFamily="Consolas" FontSize="10"
                   Foreground="{StaticResource Muted}"
                   Text="WANTED" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       FontFamily="Segoe UI" FontSize="13"
                                       Foreground="{StaticResource Ink}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Name}"
                                       ToolTip="{Binding Reason}" />

                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                       FontFamily="Consolas" FontSize="13"
                                       Foreground="{Binding Colour}"
                                       Text="{Binding Count}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
