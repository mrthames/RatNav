<Window x:Class="RatNav.App.ItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RatNav — Items"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        MinWidth="150" MinHeight="120"
        Width="200" Height="420"
        Left="24" Top="120">

    <!--
        The items list, parked somewhere of its own.

        Built to match the overlay rather than to look like a normal window: borderless, the same
        dark ground, the same row spacing and the same fixed-width count column. It is the same
        list — a chrome-heavy dialog next to a frameless overlay would read as a different
        application. Narrow and tall on purpose, so it fits down the edge of a screen.

        Its own title strip carries the two things it needs and could not otherwise offer: a way
        to put it back on the map, and something unambiguous to drag it by. Dragging the whole
        surface was tried and is unreliable — a click on a row is also a click on the window, and
        WPF cannot tell which was meant.
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="Line" Color="#24313b" />
        <SolidColorBrush x:Key="Ink" Color="#c9d6df" />
        <SolidColorBrush x:Key="Muted" Color="#7b8c9b" />
        <SolidColorBrush x:Key="Accent" Color="#8ec8ff" />

        <!--
            A scroll bar that is nearly not there.

            WPF's own is a chunky light-grey column with an arrow button at each end, which over a
            dark translucent overlay reads as a control from another application dropped into it.
            Removing it entirely was the first instinct and is one thing short of right: without
            any mark at all a list that continues below the fold looks like a list that ends, and
            you stop reading at a boundary that is not there.

            So: the thumb and nothing else. No track, no arrows, no border, four pixels wide, and
            present only when something is actually hidden — which is what Auto already decides.
            It brightens under the pointer, because at four pixels the thing you are aiming at
            should say it has been found.
        -->
        <Style x:Key="ThinScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <!--
                            One row, not the usual three. The arrow buttons are not hidden, they
                            are absent: a hidden button still takes its height, which at the top
                            and bottom of a short list is most of the bar.
                        -->
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar"
                                                    Background="#4d8ec8ff"
                                                    CornerRadius="2"
                                                    Margin="1,0" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#b38ec8ff" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>

                            <!--
                                Clicking the empty part of the track still pages, as it always
                                did. The buttons that do it are transparent and have no size of
                                their own, so the behaviour survives without the furniture.
                            -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>

                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every ScrollViewer in the overlay, without naming them one at a time. -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScroll}" />

        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="#33ffffff" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#668ec8ff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ItemRowTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="{Binding Colour}"
                           MinWidth="26" TextAlignment="Right" Margin="0,0,7,0"
                           Text="{Binding Count}" />

                <TextBlock Grid.Column="1"
                           FontFamily="Segoe UI" FontSize="11"
                           Foreground="{StaticResource Ink}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Name}"
                           ToolTip="{Binding Reason}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ItemSectionTemplate">
            <StackPanel Margin="0,0,0,5">
                <Button Command="{Binding Toggle}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="0,1">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                    <TextBlock FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource Muted}"
                               Text="{Binding Heading}" />
                </Button>

                <ItemsControl ItemsSource="{Binding Rows}"
                              Visibility="{Binding Visibility}"
                              ItemTemplate="{StaticResource ItemRowTemplate}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border Background="#e60b0f13"
            BorderBrush="{StaticResource Line}"
            BorderThickness="1"
            CornerRadius="2">
        <!--
            The same handles the main overlay uses, in the same colour.

            This window had its own quieter versions of both — a faint strip to drag, and edges you
            could resize by if you found them — which made a panel that is meant to read as part of
            the overlay behave like something else. The overlay already has a vocabulary for "this
            is a handle": a solid light-blue bar to move, a light-blue corner to pull.
        -->
        <Grid>
        <DockPanel x:Name="Root" Margin="8,6">
            <Border x:Name="TitleStrip" DockPanel.Dock="Top" Margin="0,0,0,5"
                    Height="22" CornerRadius="2,2,0,0"
                    Background="#cc8ec8ff" Cursor="SizeAll">
                <TextBlock Text="  drag to move  ·  corner to resize"
                           FontFamily="Consolas" FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#0b0f13"
                           VerticalAlignment="Center" />

            </Border>

            <!-- A legend, because the colours mean something and nothing said what. -->
            <TextBlock DockPanel.Dock="Bottom" Margin="0,5,0,0"
                       FontFamily="Consolas" FontSize="9"
                       Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap">
                <Run Foreground="#ff5a3c">■</Run><Run Text=" must be found in raid" />
            </TextBlock>

            <ScrollViewer x:Name="Scroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Sections" ItemTemplate="{StaticResource ItemSectionTemplate}" />
            </ScrollViewer>
        </DockPanel>

        <!-- Back onto the map, collapsed. Tearing off was a one-way trip without it. -->
        <Button x:Name="DockBack" Style="{StaticResource Chip}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,6,8,0" Content="✕"
                ToolTip="Put the list back on the map, collapsed" />

        <!-- The main overlay's corner, at the same size and in the same blue. -->
        <Thumb x:Name="ResizeGrip"
               Width="16" Height="16"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Cursor="SizeNWSE">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Path Data="M 16,0 L 16,16 L 0,16 Z" Fill="#cc8ec8ff" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        </Grid>
    </Border>
</Window>
