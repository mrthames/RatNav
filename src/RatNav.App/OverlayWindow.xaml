<Window x:Class="RatNav.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:RatNav.App"
        Title="RatNav"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="360" Height="240"
        MinWidth="220" MinHeight="160"
        Left="40" Top="40">

    <!--
        Two presentations of the same state.

        Box is a small panel in a corner: out of the way, never over the middle of the screen.
        Wireframe draws the map itself, large and translucent over the centre — terrain dropped
        away so the game still shows through it.

        Nothing animates in either. The scene is redrawn when the raid state changes and at no
        other time, so a visible overlay costs no per-frame work.
    -->

    <Window.Resources>
        <!-- Mirrors web/src/tokens.css. One palette, two renderers, one product. -->
        <SolidColorBrush x:Key="Ground" Color="#0b0f13" />
        <SolidColorBrush x:Key="Line" Color="#24313b" />
        <SolidColorBrush x:Key="Ink" Color="#c9d6df" />
        <SolidColorBrush x:Key="Muted" Color="#7b8c9b" />
        <SolidColorBrush x:Key="Accent" Color="#8ec8ff" />
        <SolidColorBrush x:Key="Route" Color="#e0c98a" />
        <SolidColorBrush x:Key="Need" Color="#ff5a3c" />
        <SolidColorBrush x:Key="Terrain" Color="#9fb3c8" />

        <!--
            Marks of your own. Its own colour and its own shape, because "a quest asked for this"
            and "I decided to note this" are different kinds of thing and the difference has to
            survive a glance.

            Orange rather than the yellow it reads as: yellow is already what a scav extract is,
            and two things on one map sharing a colour is what this hue exists to avoid. Far enough
            from the quests' red-orange to separate at a glance, which is the pair that matters.
        -->
        <SolidColorBrush x:Key="Mark" Color="#ffa033" />

        <!-- Extracts. The colour carries the faction; the shape is the same for both. -->
        <SolidColorBrush x:Key="PmcExit" Color="#5ee07a" />
        <SolidColorBrush x:Key="ScavExit" Color="#f5cf4a" />

        <!--
            A transit, which is yellow in the game like a Scav exit and needs telling apart from
            one on the map. The symbol carries the difference; this is a shade off the Scav
            yellow so that two yellow marks side by side are not the same mark twice.
        -->
        <SolidColorBrush x:Key="Transit" Color="#f0a63c" />

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>

        <!--
            One row of the items list. Shared by the panel beside the map and the window it tears
            off into: the same list in two places has to look like the same list.
        -->
        <!--
            A row is a button when there is something behind it and plain text otherwise. WPF
            disables a button whose Command is null, so rows with nothing to open simply do not
            respond — no second flag to keep in step with the first.
        -->
        <!--
            Declared before anything that uses it.
        
            StaticResource resolves at parse time and only looks backwards, so a template
            referencing a style defined below it throws when the template is expanded — not
            when the window loads, but the first time a row is actually drawn. Which is a
            crash that starts fine and dies the moment a plan has stops in it.
        -->
        <!--
            Every button in edit mode is one of these, so their size is edit mode's size. They were
            drawn at a scale that suited a large overlay and read as the loudest thing on a small
            one — colliding with each other and with the map behind them. Eighty-five per cent all
            round: eleven point font to nine and a half, and the padding with it.
        -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="6,1.5" />
            <Setter Property="MinWidth" Value="19" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="#33ffffff"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#668ec8ff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hit" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Background" Value="#22ffffff" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bool to Visibility, so a row can hide its controls without a code-behind pass. -->
        <app:ShowWhen x:Key="Show" />

        <DataTemplate x:Key="ItemRowTemplate">
          <Button Style="{StaticResource RowButton}" Command="{Binding Activate}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <!-- The tick-off controls, when a row has them: a column of their own so the
                         number is never underneath them. -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Count first and right-aligned in a fixed column, so the numbers line up. -->
                <TextBlock Grid.Column="1"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="{Binding Colour}"
                           MinWidth="26" TextAlignment="Right" Margin="0,0,7,0"
                           Text="{Binding Count}" />

                <TextBlock Grid.Column="2"
                           FontFamily="Segoe UI" FontSize="11"
                           Foreground="{StaticResource Ink}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Name}"
                           ToolTip="{Binding Reason}" />

                <!--
                    Tick it off, or take it out. Quest log rows only, and only while the overlay
                    has the mouse — these are the two you would least like to press by accident,
                    and over a raid they would be a target the pointer cannot reach anyway.

                    Inside the row button rather than beside it, so the row keeps its full width
                    for the name; they sit over the right-hand end of it where a long name is
                    already being ellipsised.
                -->
                <!--
                    Before the number, not after the name.

                    On the right they sat past a name that is ellipsised when it is long — so the
                    rows where you would most want to press one were the rows where it had been
                    pushed off the edge. Here they are in the same place on every row whatever the
                    name does, and the number moves aside for them rather than the name.
                -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,5,0"
                            Visibility="{Binding Editing, Converter={StaticResource Show}}">
                    <Button Style="{StaticResource Chip}" Content="✓"
                            Command="{Binding Done}"
                            ToolTip="Mark this stop done" />
                    <Button Style="{StaticResource Chip}" Content="✕"
                            Command="{Binding Remove}" Margin="3,0,0,0"
                            ToolTip="Take this stop out of the plan" />
                </StackPanel>
            </Grid>
          </Button>
        </DataTemplate>

        <!-- A section: a header you can click to fold it away, and its rows. -->
        <DataTemplate x:Key="ItemSectionTemplate">
            <StackPanel Margin="0,0,0,5">
                <Button Command="{Binding Toggle}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="0,1">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                    <TextBlock FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource Muted}"
                               Text="{Binding Heading}" />
                </Button>

                <ItemsControl ItemsSource="{Binding Rows}"
                              Visibility="{Binding Visibility}"
                              ItemTemplate="{StaticResource ItemRowTemplate}" />
            </StackPanel>
        </DataTemplate>

        <!--
            Controls exist only in interact mode, so they are styled for a moment of deliberate
            fiddling rather than for glanceability. Flat, square, and quiet until hovered.
        -->
        <!--
            A scroll bar that is nearly not there.

            WPF's own is a chunky light-grey column with an arrow button at each end, which over a
            dark translucent overlay reads as a control from another application dropped into it.
            Removing it entirely was the first instinct and is one thing short of right: without
            any mark at all a list that continues below the fold looks like a list that ends, and
            you stop reading at a boundary that is not there.

            So: the thumb and nothing else. No track, no arrows, no border, four pixels wide, and
            present only when something is actually hidden — which is what Auto already decides.
            It brightens under the pointer, because at four pixels the thing you are aiming at
            should say it has been found.
        -->
        <Style x:Key="ThinScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <!--
                            One row, not the usual three. The arrow buttons are not hidden, they
                            are absent: a hidden button still takes its height, which at the top
                            and bottom of a short list is most of the bar.
                        -->
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar"
                                                    Background="#4d8ec8ff"
                                                    CornerRadius="2"
                                                    Margin="1,0" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#b38ec8ff" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>

                            <!--
                                Clicking the empty part of the track still pages, as it always
                                did. The buttons that do it are transparent and have no size of
                                their own, so the behaviour survives without the furniture.
                            -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>

                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every ScrollViewer in the overlay, without naming them one at a time. -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScroll}" />

        <!--
            A dropdown that looks like the rest of the overlay.

            Templated rather than styled, because WPF's own ComboBox brings a light chrome with it
            that cannot be talked out of the popup — and a white list dropping out of a dark
            translucent overlay over a game reads as another application's window opening.
        -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#668ec8ff" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#3324313b" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Face"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="#33ffffff"
                                                BorderBrush="{StaticResource Line}"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Padding="7,2">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text=" ▾"
                                                           Foreground="{StaticResource Muted}"
                                                           VerticalAlignment="Center" />
                                                <ContentPresenter x:Name="Face"
                                                                  Content="{Binding SelectionBoxItem,
                                                                            RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="#668ec8ff" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True"
                                   PopupAnimation="None" StaysOpen="False">
                                <Border Background="#f50b0f13"
                                        BorderBrush="{StaticResource Line}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The dividers.

            One style each way rather than a template repeated at four call sites: there is a
            divider wherever a panel meets the map, which is both sides, and another between the
            two panels when they share a side.

            Seven pixels of grab for a one-pixel line. The line says where the edge is; the seven
            are what a moving hand can actually hit. They brighten under the pointer because an
            invisible-until-you-find-it handle is the thing being fixed here.
        -->
        <Style x:Key="VSplit" TargetType="Thumb">
            <Setter Property="Width" Value="7" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grab" Background="#3324313b">
                            <Rectangle Width="1" Fill="{StaticResource Line}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grab" Property="Background" Value="#668ec8ff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HSplit" TargetType="Thumb">
            <Setter Property="Height" Value="7" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grab" Background="#3324313b">
                            <Rectangle Height="1" Fill="{StaticResource Line}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grab" Property="Background" Value="#668ec8ff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The map, drawn from the game's own map file. Sits behind the readout in both modes. -->
        <Border x:Name="Frame"
                Background="#e60b0f13"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="2">
            <Grid Margin="5,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    A name and the drawers, then where you are going.

                    The big line used to be the next stop's quest name — one of however many were
                    in the plan, picked because it happened to be first, which said less than it
                    implied. The quest log says all of them; this says whose overlay it is and
                    leaves room for the handles that open them.
                -->
                <!--
                    One line, not two. The name and the bearing sat stacked, which cost the top of
                    the overlay twice the height of the strip at the bottom for two short pieces of
                    text — and every pixel here is one the map does not get.
                -->
                <DockPanel x:Name="Readout" Grid.Row="0" LastChildFill="True">
                    <!--
                        The name on the left and always there. Anyone glancing at a stranger's
                        screen should be able to tell what this is, and a label that appears
                        only in interact mode cannot do that.
                    -->
                    <TextBlock Text="RATNAV" DockPanel.Dock="Left" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource Muted}" />

                    <!--
                        How old the position fix is, opposite the name.

                        It used to sit in the footer beside the drawer chips, in a column that took
                        whatever width it wanted from controls that needed it more. Up here it is
                        alone on its row, it is the other thing this line is for, and the footer
                        gets its width back.

                        No distance and bearing to the next stop, though. That read as useful and
                        was not: a straight line to a pin through whatever walls are between you and
                        it, on a bearing relative to a heading that was current at your last fix.
                    -->
                    <TextBlock x:Name="FixAgeText" DockPanel.Dock="Right"
                               Style="{StaticResource Label}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <!--
                    Map and items side by side. The list is a narrow strip rather than a block
                    under the map, because that is the shape that leaves the map its height — and
                    which side it sits on is the player's call, since the overlay could be against
                    either edge of the screen.
                -->
                <Grid Grid.Row="1" Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftSlot" Width="0" />
                        <ColumnDefinition x:Name="MapSlot" Width="*" MinWidth="80" />
                        <ColumnDefinition x:Name="RightSlot" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="MapFrame" Grid.Column="1"
                            Background="#33141b21"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1">
                        <Grid ClipToBounds="True">
                            <!--
                                Two layers, and the split is what makes the HUD's edge fade
                                possible at all.

                                The drawing fades out toward the edges of a full-screen HUD so the
                                map dissolves into the game rather than stopping at a border. That
                                is an OpacityMask, and a mask over everything would take the edge
                                arrows with it — which are drawn at the edges precisely because
                                that is where the things you cannot see are. So the map goes on its
                                own layer and the mask goes on that; the pins, captions and arrows
                                sit above it and are never faded.
                            -->
                            <Canvas x:Name="MapInk" ClipToBounds="True" />
                            <Canvas x:Name="MapCanvas" ClipToBounds="True" />

                            <!--
                                What the cursor is over, drawn rather than popped.

                                A WPF ToolTip is a popup owned by a window that never activates —
                                this one is Topmost with WS_EX_NOACTIVATE — so it opened and was
                                dismissed in the same instant, which is exactly what a hover here
                                looked like. Drawn into the scene it simply stays.

                                Its own layer above the map so redrawing the map does not take it
                                with it, and hit-test invisible so it cannot get between the cursor
                                and the thing being hovered.
                            -->
                            <!--
                                A quest, opened by clicking its waypoint: what it wants, which
                                step this pin serves, and the wiki's pictures of the place.

                                Over the map rather than beside it. This is read while standing
                                still, and it is worth the whole overlay for the moment it is up.
                            -->

                            <!--
                                What to press, while the map does not know where you are.

                                A raid loads and the map draws immediately, centred on the middle
                                of itself, which looks like a map that has decided something when
                                what it has done is wait. The footer says the same thing in small
                                text at the bottom; this is the moment it is worth saying loudly,
                                and it is over the map because that is where the eye already is.

                                Hit-test invisible, so it cannot get between the pointer and
                                anything, and gone for good once the first fix lands.
                            -->
                            <!--
                                Bounded, and everything inside it wraps.

                                It sized itself to the longest line it contained, which on a small
                                overlay is wider than the map — so the bottom line ran off the
                                sides and simply was not there. A prompt whose own explanation is
                                invisible has failed at the one thing it is for.
                            -->
                            <Border x:Name="NoFixPrompt"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#e60b0f13"
                                    BorderBrush="{StaticResource Accent}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="10,8"

                                    MaxWidth="260">
                                <StackPanel>
                                    <!--
                                        Sized with the RATNAV title rather than above it. At 18 it
                                        was the largest thing on screen, for a line that says which
                                        key to press once per raid.
                                    -->
                                    <TextBlock x:Name="NoFixKey"
                                               FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource Accent}"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="to place yourself on the map"
                                               FontFamily="Segoe UI" FontSize="11"
                                               Foreground="{StaticResource Ink}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="the game's screenshot key — RatNav reads where it was taken"
                                               Style="{StaticResource Label}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="HoverCard"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="#f00b0f13"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="6,3">
                                <TextBlock x:Name="HoverText"
                                           FontFamily="Segoe UI" FontSize="11"
                                           Foreground="{StaticResource Ink}"
                                           MaxWidth="240" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>

                    <!--
                        Grab the edge to give a panel more room, or take it back. One per side,
                        because a panel can sit on either and there is an edge to grab wherever
                        one meets the map. There used to be a single handle that moved to
                        whichever side the items list was on, which left the other side's panel
                        with no edge at all.
                    -->
                    <Thumb x:Name="LeftSplitter" Grid.Column="0" Style="{StaticResource VSplit}"
                           HorizontalAlignment="Right" />

                    <Thumb x:Name="RightSplitter" Grid.Column="2" Style="{StaticResource VSplit}"
                           HorizontalAlignment="Left" />

                    <!--
                        Whichever drawers are set to this side, one above the other with a divider
                        between them.

                        A Grid rather than a StackPanel, and that is the whole fix for two separate
                        faults. A StackPanel gives each child the height it asks for, so the lists
                        sized themselves to their contents, never overflowed, and their
                        ScrollViewers had nothing to scroll — which is what "scrolling is dead"
                        was. And there is no way to drag a boundary that is only wherever the
                        first child happened to stop.

                        Star heights mean the two share the space in a ratio, the drag changes the
                        ratio, and both are bounded — so whichever is too short to fit its contents
                        scrolls, which is what was wanted.
                    -->
                    <Grid x:Name="LeftDrawers" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="LeftTopRow" Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="LeftBottomRow" Height="*" />
                        </Grid.RowDefinitions>

                        <Thumb x:Name="LeftStack" Grid.Row="1" Style="{StaticResource HSplit}"
                               Margin="0,0,6,0" />
                    </Grid>

                    <Grid x:Name="RightDrawers" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="RightTopRow" Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="RightBottomRow" Height="*" />
                        </Grid.RowDefinitions>

                        <Thumb x:Name="RightStack" Grid.Row="1" Style="{StaticResource HSplit}"
                               Margin="6,0,0,0" />
                    </Grid>

                    <!--
                        The plan's quests, numbered as they are on the map. Deliberately the same
                        parts as the items list — sections, rows, collapse, pop out, either side —
                        because it is the same idea and two of anything drift apart.
                    -->
                    <Border x:Name="QuestPanel" Grid.Column="0" Visibility="Collapsed"
                            Margin="0,0,6,0" Padding="6,4"
                            Background="#33141b21" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
                                <Button x:Name="CollapseQuests" DockPanel.Dock="Left"
                                        Style="{StaticResource Chip}" Content="–"
                                        ToolTip="Fold the quest log away" />
                                <Button x:Name="SwapQuestsSide" DockPanel.Dock="Left" Margin="4,0,0,0"
                                        Style="{StaticResource Chip}" Content="⇄"
                                        ToolTip="Move the log to the other side"
                                        Visibility="Collapsed" />
                                <Button x:Name="DetachQuests" DockPanel.Dock="Right"
                                        Style="{StaticResource Chip}" Content="pop out"
                                        Visibility="Collapsed" />
                            </DockPanel>

                            <TextBlock x:Name="QuestEmpty" Style="{StaticResource Label}"
                                       TextWrapping="Wrap" Visibility="Collapsed"
                                       Text="No plan yet. Build one on the Plan tab and its stops appear here, numbered as on the map." />

                            <ScrollViewer x:Name="QuestScroll"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="QuestList"
                                              ItemTemplate="{StaticResource ItemSectionTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>


                    <Border x:Name="ItemsPanel" Grid.Column="2" Visibility="Collapsed"
                            Margin="6,0,0,0" Padding="6,4"
                            Background="#33141b21" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
                                <Button x:Name="CollapseItems" DockPanel.Dock="Left"
                                        Style="{StaticResource Chip}" Content="–"
                                        ToolTip="Fold the list away" />
                                <Button x:Name="SwapSide" DockPanel.Dock="Left" Margin="4,0,0,0"
                                        Style="{StaticResource Chip}" Content="⇄"
                                        ToolTip="Move the list to the other side"
                                        Visibility="Collapsed" />
                                <Button x:Name="DetachItems" DockPanel.Dock="Right"
                                        Style="{StaticResource Chip}" Content="pop out"
                                        Visibility="Collapsed" />
                            </DockPanel>

                            <!-- The colours mean something and nothing said what. -->
                            <TextBlock DockPanel.Dock="Bottom" Margin="0,5,0,0"
                                       FontFamily="Consolas" FontSize="9"
                                       Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap">
                                <Run Foreground="#ff5a3c">■</Run><Run Text=" must be found in raid" />
                            </TextBlock>

                            <ScrollViewer x:Name="ItemsScroll"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ItemsList"
                                              ItemTemplate="{StaticResource ItemSectionTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!--
                    Two rows rather than three things sharing one cell.

                    They were laid on top of each other in a single-cell Grid, which is fine at the
                    size it was drawn at and overlaps the moment the UI is scaled up. The chips and
                    the raid status get a row and cannot reach each other; the key-bind strip gets
                    the row beneath, which is where it belongs anyway.
                -->
                <Grid x:Name="StatusRow" Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        A WrapPanel, because a horizontal StackPanel does not run out of room — it
                        overflows, and what it overflowed onto was the timestamp in the column
                        beside it. Folding the map away makes the overlay narrow enough for that to
                        happen, and the chip it ran under was **map**, which is the one control that
                        unfolds it again. Turning a fold into a one-way trip.

                        Wrapping, the row grows a line instead. That also settles the same
                        collision at large UI scales, where the chips get wider rather than the
                        window narrower.
                    -->
                    <WrapPanel Grid.Row="0" Grid.Column="0"
                               Orientation="Horizontal" HorizontalAlignment="Left">
                        <!--
                            Down here rather than in the header. Up there it sat on top of the
                            drawer handles, and it is the control you reach for least of the three.
                        -->
                        <Button x:Name="ExpandControls" Style="{StaticResource Chip}"
                                Content="⚙" Margin="0,0,6,0"
                                ToolTip="Show the map controls"
                                Visibility="Collapsed" />

                        <!--
                            The drawer handles live down here. In the header they shared a row with
                            the quick controls, which float over the top of the window and reach
                            far enough left to swallow them.
                        -->
                        <Button x:Name="QuestDrawer" Style="{StaticResource Chip}"
                                Content="quests" Margin="0,0,4,0"
                                ToolTip="The plan's quests, numbered as on the map" />
                        <Button x:Name="ItemsDrawer" Style="{StaticResource Chip}"
                                Content="items" Margin="0,0,4,0"
                                ToolTip="What to pick up" />

                        <!--
                            The map is a drawer too, and for the same reason the lists are: when
                            you are standing in a corner reading what you still need, the map is
                            the biggest thing on screen and the least useful. Folding it leaves a
                            narrow strip of exactly the two lists.
                        -->
                        <Button x:Name="MapDrawer" Style="{StaticResource Chip}"
                                Content="map" Margin="0,0,8,0"
                                ToolTip="Fold the map away, leaving the lists" />

                    </WrapPanel>

                    <!--
                        The key-bind reminder, in the middle of the footer.

                        Here rather than on its own line, and shown always rather than only with
                        the controls: the moment you need reminding which key does what is the
                        moment you are looking at the plain overlay, not the moment you have
                        already found the controls.
                    -->
                    <ItemsControl x:Name="HotkeyHints" Grid.Row="1" Grid.ColumnSpan="2"
                                  Margin="0,2,0,0" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <app:CenteredWrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,9,0">
                                    <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontSize="9"
                                               Foreground="{StaticResource Ink}" />
                                    <TextBlock Text="{Binding Does}" Margin="3,0,0,0"
                                               FontFamily="Consolas" FontSize="9"
                                               Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Grid>
                <!--
                    Over the whole panel, not over the map.

                    It lived inside the map's own grid, so with the lists open it covered the
                    map and stopped dead at their edge — a modal with two panels of something
                    else beside it, which reads as a thing that has failed to open properly
                    rather than as a thing laid over the overlay.
                -->
                <!--
                    Everything that is not the brief, while the brief is up.

                    Nearly transparent rather than actually transparent: a Background
                    of Transparent is hit-testable and one of null is not, and this
                    exists only to be clicked. Dismissing by clicking away is what a
                    thing calling itself a modal is expected to do, and the close
                    button is a long way from wherever the pointer happens to be.
                -->
                <Border x:Name="QuestBriefScrim" Grid.Row="0" Grid.RowSpan="4"
                        Visibility="Collapsed"
                        Background="#66000000" />

                <Border x:Name="QuestBrief" Grid.Row="0" Grid.RowSpan="4"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Background="#f50b0f13"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="10,8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button x:Name="QuestBriefClose" DockPanel.Dock="Right"
                                    Style="{StaticResource Chip}" Content="✕"
                                    ToolTip="Close" />

                            <Button x:Name="QuestBriefWiki" DockPanel.Dock="Right"
                                    Style="{StaticResource Chip}" Content="wiki ↗"
                                    Margin="0,0,4,0"
                                    ToolTip="Open the wiki article in your browser" />

                            <TextBlock x:Name="QuestBriefName"
                                       FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource Ink}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- The pictures take the space: they are the half that turns
                             "walk to this pin" into "find this door". -->
                        <!--
                            A fixed box, with the picture fitted inside it.

                            The box used to take its height from the picture, and wiki
                            screenshots are all shapes — so the back and next controls,
                            centred against it, moved every time one loaded. You cannot
                            flick through pictures whose buttons are somewhere new each
                            time; you have to find them again first.
                        -->
                        <ScrollViewer x:Name="QuestBriefScroll"
                                      DockPanel.Dock="Top"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="QuestBriefSteps">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="Segoe UI" FontSize="11"
                                                   Margin="0,1"
                                                   TextWrapping="Wrap"
                                                   Foreground="{Binding Colour}"
                                                   Text="{Binding Text}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!--
                            The picture takes everything left over, directly under the
                            text rather than pinned to the floor of the panel.

                            Docked to the bottom at a fixed height, it left a gap the
                            height of whatever the steps did not use — text along the
                            top, picture along the bottom, nothing in between. The
                            fixed box was there so that the back and next controls did
                            not move as pictures of different shapes loaded, and that
                            still holds: the box is now sized by the panel and the
                            text above it, neither of which changes while you flick
                            through one quest's pictures.
                        -->
                        <Grid Margin="0,6,0,0">
                            <Image x:Name="QuestBriefImage" Stretch="Uniform" />

                            <Button x:Name="QuestBriefBack" Style="{StaticResource Chip}"
                                    Content="‹" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Opacity="0.85" />

                            <Button x:Name="QuestBriefNext" Style="{StaticResource Chip}"
                                    Content="›" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Opacity="0.85" />

                            <TextBlock x:Name="QuestBriefCaption" Style="{StaticResource Label}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        </Grid>

                    </DockPanel>
                </Border>

            </Grid>
        </Border>

        <!--
            The answer to "what is this for?", shown after the identify key is pressed and
            dismissed on the next press or the next fix. Sits over the readout rather than beside
            it: while you are reading this you are standing in your stash, not navigating.
        -->
        <Border x:Name="IdentifyCardPanel" Visibility="Collapsed"
                VerticalAlignment="Top" Margin="8"
                Padding="10,8"
                Background="#f20b0f13"
                BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="2">
            <StackPanel>
                <TextBlock x:Name="IdentifyName"
                           FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="IdentifyHedge" Style="{StaticResource Label}" Margin="0,1,0,0" />

                <ItemsControl x:Name="IdentifyReasons" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas" FontSize="11"
                                       Foreground="{Binding Colour}"
                                       TextWrapping="Wrap"
                                       Margin="0,1"
                                       Text="{Binding Text}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!--
            Interaction furniture, shown only while the overlay accepts the mouse. Hidden the rest
            of the time so nothing decorative sits over the game during a raid.
        -->
        <Grid x:Name="EditChrome" Visibility="Collapsed">
            <!--
                Rows rather than a pile. The grab bar and the controls were both anchored to the
                top-left and overlapped each other, so the bar's text ran under the first control.
                A row each means neither has to guess how tall the other is.
            -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                A visible edge and something to grab, in both presentations. The centred map draws
                no frame of its own, so without this there was nothing on screen to take hold of.
            -->
            <Border Grid.RowSpan="2"
                    Background="#140b0f13"
                    BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="2"
                    IsHitTestVisible="False" />

            <Border x:Name="DragHandle" Grid.Row="0"
                    Height="22"
                    Background="#cc8ec8ff" CornerRadius="2,2,0,0"
                    Cursor="SizeAll">
                <TextBlock Text="  drag to move  ·  wheel to zoom  ·  right-drag the map  ·  corner to resize"
                           FontFamily="Consolas" FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#0b0f13" VerticalAlignment="Center" />
            </Border>

            <!--
                The centred view's own gear.

                The corner view's lives in the footer, next to the drawer handles — and the footer
                is one of the things the centred view deliberately does not draw, which left the
                controls foldable with nothing on screen to unfold them. A second button rather
                than moving the first: in the corner view the footer is exactly where it belongs.

                Floating over the map, because the centred view fills the screen and has no margin
                to give up.
            -->
            <Button x:Name="CentredControls" Grid.Row="1" Style="{StaticResource Chip}"
                    Content="⚙" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0"
                    ToolTip="Show the map controls" />

            <!--
                The map controls, stacked down the side.

                They were a single row, which meant reaching fade or zoom required widening the map
                first — backwards, since the map is the thing you were trying to see. Stacked they
                fit any width, they scroll when the overlay is short, and they collapse to a single
                button so the items list can have the other edge without being pushed around.

                Grouped in the order you reach for them: what to draw, how hard to draw it, where
                the map sits, then the list.
            -->
            <!--
                Everything that is not the settings, while the settings are up. Same sheet the
                quest brief uses, and clicking it puts them away.
            -->
            <Border x:Name="ControlScrim" Grid.Row="1"
                    Visibility="Collapsed"
                    Background="#66000000" />

            <!--
                A panel in the middle rather than a drawer down the left edge.

                Down the side it was as narrow as the overlay was, which at 1080p is not very, and
                every row of it was a cramped little column of chips over the map. Centred it can
                be a comfortable width and scroll for its height, and what it covers while it is
                open does not matter — nobody is reading the map while changing how the map is
                drawn.
            -->
            <Border x:Name="ControlStack" Grid.Row="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="360" MaxWidth="520"
                    Padding="12,10"
                    Background="#f50b0f13"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="SETTINGS"
                                   Style="{StaticResource Label}"
                                   Foreground="{StaticResource Ink}"
                                   VerticalAlignment="Center" />

                        <Button x:Name="CollapseControls" DockPanel.Dock="Right"
                                Style="{StaticResource Chip}" Content="✕"
                                ToolTip="Close the settings" />
                    </DockPanel>

                    <ScrollViewer x:Name="ControlScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <!--
                            Two columns, not one long strip.
                        
                            Fifteen dials stacked single file made a tall, narrow modal that ran the
                            height of the panel and still had to scroll. Each label and the control
                            under it is one cell, so the pair can never be split across a column
                            boundary — which is the failure mode of simply letting a stack wrap.
                        -->
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Label}" Text="FLOOR" Margin="0,0,0,2" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="FloorDown" Style="{StaticResource Chip}" Content="▼" />
                                    <TextBlock x:Name="FloorText" Style="{StaticResource Label}"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                               MinWidth="72" TextAlignment="Center" Text="—" />
                                    <Button x:Name="FloorUp" Style="{StaticResource Chip}" Content="▲" />
                                </StackPanel>

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Label}" Text="DRAW" Margin="0,0,0,2" />
                                <StackPanel Margin="0,0,0,6">
                                    <!-- Arrows, so it is visibly one of several rather than a switch. -->
                                    <DockPanel Margin="0,0,0,2">
                                        <Button x:Name="InkBack" DockPanel.Dock="Left"
                                                Style="{StaticResource Chip}" Content="‹" />
                                        <Button x:Name="InkNext" DockPanel.Dock="Right"
                                                Style="{StaticResource Chip}" Content="›" />
                                        <TextBlock x:Name="InkButton" Style="{StaticResource Label}"
                                                   Foreground="{StaticResource Ink}"
                                                   VerticalAlignment="Center" TextAlignment="Center"
                                                   Text="graphical" />
                                    </DockPanel>
                                    <Button x:Name="GhostButton" Style="{StaticResource Chip}"
                                            Content="ghost on" HorizontalAlignment="Stretch" Margin="0,0,0,2" />
                                    <Button x:Name="PlacesButton" Style="{StaticResource Chip}"
                                            Content="names on" HorizontalAlignment="Stretch" Margin="0,0,0,2" />
                                    <Button x:Name="HaloButton" Style="{StaticResource Chip}"
                                            Content="halo on" HorizontalAlignment="Stretch" />
                                    <Button x:Name="HintsButton" Style="{StaticResource Chip}"
                                            Content="hints on" HorizontalAlignment="Stretch" Margin="0,2,0,0"
                                            ToolTip="The strip of key reminders under the map" />
                                </StackPanel>

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Label}" Text="FADE" Margin="0,0,0,2" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="FadeDown" Style="{StaticResource Chip}" Content="−" />
                                    <TextBlock x:Name="FadeText" Style="{StaticResource Label}"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                               MinWidth="46" TextAlignment="Center" Text="55%" />
                                    <Button x:Name="FadeUp" Style="{StaticResource Chip}" Content="+" />
                                </StackPanel>

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <!--
                                    Opacity, zoom and UI scale, moved down from the quick bar.

                                    They were three of the five things always on screen in edit mode,
                                    and in edit mode what you are looking at is the map — so five rows
                                    of dials across the top of it were mostly in the way. These are set
                                    once and then left alone, which is what the gear is for; floor,
                                    follow and which exits to show are the ones that change while you
                                    play, and they stayed up there.
                                -->
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Label}" Text="OPACITY" Margin="0,0,0,2" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="WindowFadeDown" Style="{StaticResource Chip}" Content="−" />
                                    <TextBlock x:Name="WindowFadeText" Style="{StaticResource Label}"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                               MinWidth="46" TextAlignment="Center" Text="100%" />
                                    <Button x:Name="WindowFadeUp" Style="{StaticResource Chip}" Content="+" />
                                </StackPanel>

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Label}" Text="ZOOM" Margin="0,0,0,2" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="ZoomDown" Style="{StaticResource Chip}" Content="−" />
                                    <TextBlock x:Name="ZoomText" Style="{StaticResource Label}"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                               MinWidth="46" TextAlignment="Center" Text="1.0×" />
                                    <Button x:Name="ZoomUp" Style="{StaticResource Chip}" Content="+" />
                                </StackPanel>

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Label}" Text="UI SCALE" Margin="0,0,0,2" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="UiScaleDown" Style="{StaticResource Chip}" Content="−" />
                                    <TextBlock x:Name="UiScaleText" Style="{StaticResource Label}"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                               MinWidth="46" TextAlignment="Center" Text="1.0×" />
                                    <Button x:Name="UiScaleUp" Style="{StaticResource Chip}" Content="+" />
                                </StackPanel>

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Label}" Text="LINE" Margin="0,0,0,2" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="WeightDown" Style="{StaticResource Chip}" Content="−" />
                                    <TextBlock x:Name="WeightText" Style="{StaticResource Label}"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                               MinWidth="46" TextAlignment="Center" Text="1.00×" />
                                    <Button x:Name="WeightUp" Style="{StaticResource Chip}" Content="+" />
                                </StackPanel>

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Label}" Text="PINS" Margin="0,0,0,2" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="MarkerDown" Style="{StaticResource Chip}" Content="−" />
                                    <TextBlock x:Name="MarkerText" Style="{StaticResource Label}"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                               MinWidth="46" TextAlignment="Center" Text="3.0×" />
                                    <Button x:Name="MarkerUp" Style="{StaticResource Chip}" Content="+" />
                                </StackPanel>

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <!--
                                    Two dials rather than one, because the two kinds of text are doing
                                    opposite jobs: the map's place names are the backdrop you read to
                                    know which end of the map you are on, and a waypoint's caption is
                                    the thing you are walking to. One control for both meant neither
                                    was ever the right size.
                                -->
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Label}" Text="WAYPOINTS" Margin="0,0,0,2"
                                           ToolTip="Captions on stops, extracts, marks and edge arrows" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="TextDown" Style="{StaticResource Chip}" Content="−" />
                                    <TextBlock x:Name="TextScaleText" Style="{StaticResource Label}"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                               MinWidth="46" TextAlignment="Center" Text="2.0×" />
                                    <Button x:Name="TextUp" Style="{StaticResource Chip}" Content="+" />
                                </StackPanel>

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Label}" Text="MAP LABELS" Margin="0,0,0,2"
                                           ToolTip="The place names drawn from the map itself" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="PlaceNameDown" Style="{StaticResource Chip}" Content="−" />
                                    <TextBlock x:Name="PlaceNameText" Style="{StaticResource Label}"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                               MinWidth="46" TextAlignment="Center" Text="2.0×" />
                                    <Button x:Name="PlaceNameUp" Style="{StaticResource Chip}" Content="+" />
                                </StackPanel>

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Label}" Text="YOU" Margin="0,0,0,2"
                                           ToolTip="Your marker and facing cone — one size at every zoom" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="YouDown" Style="{StaticResource Chip}" Content="−" />
                                    <TextBlock x:Name="YouText" Style="{StaticResource Label}"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                               MinWidth="46" TextAlignment="Center" Text="3.0×" />
                                    <Button x:Name="YouUp" Style="{StaticResource Chip}" Content="+" />
                                </StackPanel>

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Label}" Text="SHRINK" Margin="0,0,0,2"
                                           ToolTip="How much pins and text shrink as you zoom out" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="ShrinkDown" Style="{StaticResource Chip}" Content="−" />
                                    <TextBlock x:Name="ShrinkText" Style="{StaticResource Label}"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                               MinWidth="46" TextAlignment="Center" Text="0.55" />
                                    <Button x:Name="ShrinkUp" Style="{StaticResource Chip}" Content="+" />
                                </StackPanel>

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Label}" Text="MAP" Margin="0,0,0,2" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="ZoomReset" Style="{StaticResource Chip}" Content="1.0×" MinWidth="44" />
                                    <Button x:Name="FollowButton" Style="{StaticResource Chip}"
                                            Content="still" MinWidth="62" Margin="2,0,0,0" />
                                    <Button x:Name="RecentreButton" Style="{StaticResource Chip}" Content="⌖"
                                            Margin="2,0,0,0"
                                            ToolTip="Recenter on you and follow again"
                                            Visibility="Collapsed" />
                                </StackPanel>

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <!--
                                    The centred view's own three, hidden in the corner panel because
                                    none of them mean anything there. Coverage is the dial that turns
                                    the centred map into a HUD: at 100% it takes the whole screen, the
                                    drawing dissolves toward the edges, and the lines glow rather than
                                    sit in ink.
                                -->
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <StackPanel x:Name="HudControls" Visibility="Collapsed">
                                    <!--
                                        Which way is up. Turning the map means what is drawn at the top
                                        of the screen is what is in front of you, which is the reason
                                        to have a map in the middle of the screen at all. North-up is
                                        still here because that is what a map normally means.
                                    -->
                                    <Button x:Name="TurnButton" Style="{StaticResource Chip}"
                                            Content="turns with you" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                            ToolTip="Turn the map so your heading points up the screen, or keep it north-up" />

                                    <TextBlock Style="{StaticResource Label}" Text="COVERAGE" Margin="0,0,0,2"
                                               ToolTip="How much of the screen the centered map takes. 100% is the full-screen HUD." />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button x:Name="CoverageDown" Style="{StaticResource Chip}" Content="−" />
                                        <TextBlock x:Name="CoverageText" Style="{StaticResource Label}"
                                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                                   MinWidth="46" TextAlignment="Center" Text="70%" />
                                        <Button x:Name="CoverageUp" Style="{StaticResource Chip}" Content="+" />
                                    </StackPanel>

                                    <StackPanel x:Name="FullScreenControls" Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource Label}" Text="EDGE FADE" Margin="0,0,0,2"
                                                   ToolTip="Where the drawing starts dissolving into the game. Lower fades sooner." />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button x:Name="FadeEdgeDown" Style="{StaticResource Chip}" Content="−" />
                                            <TextBlock x:Name="FadeEdgeText" Style="{StaticResource Label}"
                                                       Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                                       MinWidth="46" TextAlignment="Center" Text="55%" />
                                            <Button x:Name="FadeEdgeUp" Style="{StaticResource Chip}" Content="+" />
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource Label}" Text="GLOW" Margin="0,0,0,2"
                                                   ToolTip="How much the map lines bloom" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button x:Name="GlowDown" Style="{StaticResource Chip}" Content="−" />
                                            <TextBlock x:Name="GlowText" Style="{StaticResource Label}"
                                                       Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                                       MinWidth="46" TextAlignment="Center" Text="1.6×" />
                                            <Button x:Name="GlowUp" Style="{StaticResource Chip}" Content="+" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Label}" Text="EXITS" Margin="0,0,0,2" />
                                <Button x:Name="ExtractButton" Style="{StaticResource Chip}"
                                        Content="PMC" HorizontalAlignment="Stretch" Margin="0,0,0,6" />

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <!--
                                    Named to match the app's Maps page, because what you can turn on
                                    and off should read the same in both places. What the three mean is
                                    the overlay's own: the overlay has a plan and the Maps page does
                                    not.
                                -->
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Label}" Text="QUESTS" Margin="0,0,0,2" />
                                <Button x:Name="QuestVisibility" Style="{StaticResource Chip}"
                                        Content="Active" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                        ToolTip="Active: the plan's stops · All: every started quest on this map · Off: none" />

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <Button x:Name="OpenAppButton" Style="{StaticResource Chip}"
                                        Content="open planner" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                        ToolTip="Open the app in your browser" />

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <Button x:Name="OfferedButton" Style="{StaticResource Chip}"
                                        Content="all extracts" HorizontalAlignment="Stretch" Margin="0,2,0,6"
                                        ToolTip="Show every extract again, forgetting what the game listed" />

                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <!--
                                    No items toggle here. The drawer handles sit at the bottom of the
                                    window whenever interact mode is on, which is exactly when this
                                    stack is open — two controls for one drawer, and the one you can
                                    always see wins.
                                -->
                            </StackPanel>
                        </UniformGrid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!--
                The three reached for constantly, always to hand: how solid the window is, how far
                the map is zoomed, and whether it follows you. Everything else lives in the stack,
                which can stay folded.
            -->
            <Border x:Name="QuickBar" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,6,26,0" Padding="4,3"
                    Background="#e60b0f13"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2">
                <!--
                    One row. Wrapping was the answer while this bar carried five groups and could
                    genuinely outgrow a narrow overlay; with three it fits, and a control bar that
                    stacks itself into a block over the map is worse than the overflow it was
                    avoiding.
                -->
                <StackPanel Orientation="Horizontal">
                    <!--
                        What changes while you are playing, and nothing else.

                        This bar sits over the map whenever edit mode is on, so everything on it is
                        costing map. Opacity, zoom and UI scale are set once and then left alone —
                        they are in the gear now. Which floor, whether the map follows you and
                        which exits to show are the three that genuinely change mid-raid.
                    -->
                    <!--
                        Which floor, with "Stacked" first and default.

                        Every floor is drawn on top of the other by default, because choosing one
                        for you off your height was solving a problem the map does not have and
                        getting it wrong emptied the drawing. Isolating one is still a reasonable
                        thing to *want*, so it is here — one click away rather than in the drawer,
                        and never changed underneath you by a position fix.
                    -->
                    <TextBlock Style="{StaticResource Label}" Text="FLOOR" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox x:Name="QuickFloor" Style="{StaticResource DarkCombo}"
                              MinWidth="86" VerticalAlignment="Center"
                              ToolTip="Draw every floor stacked, or isolate one" />

                    <Rectangle Width="1" Margin="8,2" Fill="{StaticResource Line}" />

                    <!--
                        How big everything RatNav draws is. Defaults are sized for 1080p; a 4K
                        screen has four times the pixels in the same physical space, so without
                        this everything lands at a quarter of the area.
                    -->

                    <!--
                        Which exits are drawn: your faction's, the other's, both, or none.

                        In the bar rather than the drawer because it is the one the tester reached for
                        most, and because the answer changes with what you queued as.
                    -->
                    <TextBlock Style="{StaticResource Label}" Text="EXITS" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button x:Name="QuickExtracts" Style="{StaticResource Chip}"
                            MinWidth="52" Content="Both"
                            ToolTip="Whose extracts to draw: Both, PMC, Scav or Off" />

                    <!--
                        Transits, separately. Two questions rather than one: whose extracts you
                        want and whether you want the ways onward as well. Anybody can take a
                        transit, so the faction control has nothing to say about them.
                    -->
                    <Button x:Name="QuickTransits" Style="{StaticResource Chip}"
                            MinWidth="66" Content="transit off" Margin="4,0,0,0"
                            ToolTip="Draw transits to other maps" />

                    <Rectangle Width="1" Margin="8,2" Fill="{StaticResource Line}" />

                    <!--
                        Which extracts the map shows, both ways round.

                        Reading the game's list used to be a one-way trip: the control that turned
                        it on lived in the drawer and there was nothing to turn it off, so the only
                        way back to every extract was to take the reading again.
                    -->
                    <Button x:Name="QuickOffered" Style="{StaticResource Chip}"
                            MinWidth="82" Content="all exits"
                            ToolTip="Show every extract, or only the ones the game offered you" />

                    <Rectangle Width="1" Margin="8,2" Fill="{StaticResource Line}" />

                    <Button x:Name="QuickFollow" Style="{StaticResource Chip}"
                            Content="still" MinWidth="58"
                            ToolTip="Hold the map still, or keep it centered on you" />
                </StackPanel>
            </Border>

            <Thumb x:Name="ResizeGrip" Grid.Row="1"
                   Width="16" Height="16"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Path Data="M 16,0 L 16,16 L 0,16 Z" Fill="#cc8ec8ff" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Grid>
</Window>
