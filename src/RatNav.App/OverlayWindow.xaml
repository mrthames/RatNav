<Window x:Class="RatNav.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RatNav"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="360" Height="240"
        Left="40" Top="40">

    <!--
        Two presentations of the same state.

        Box is a small panel in a corner: out of the way, never over the middle of the screen.
        Wireframe draws the map itself, large and translucent over the centre — terrain dropped
        away so the game still shows through it.

        Nothing animates in either. The scene is redrawn when the raid state changes and at no
        other time, so a visible overlay costs no per-frame work.
    -->

    <Window.Resources>
        <!-- Mirrors web/src/tokens.css. One palette, two renderers, one product. -->
        <SolidColorBrush x:Key="Ground" Color="#0b0f13" />
        <SolidColorBrush x:Key="Line" Color="#24313b" />
        <SolidColorBrush x:Key="Ink" Color="#c9d6df" />
        <SolidColorBrush x:Key="Muted" Color="#7b8c9b" />
        <SolidColorBrush x:Key="Accent" Color="#8ec8ff" />
        <SolidColorBrush x:Key="Route" Color="#e0c98a" />
        <SolidColorBrush x:Key="Need" Color="#ff5a3c" />
        <SolidColorBrush x:Key="Terrain" Color="#9fb3c8" />

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>

        <!--
            One row of the items list. Shared by the panel beside the map and the window it tears
            off into: the same list in two places has to look like the same list.
        -->
        <DataTemplate x:Key="ItemRowTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Count first and right-aligned in a fixed column, so the numbers line up. -->
                <TextBlock Grid.Column="0"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="{Binding Colour}"
                           MinWidth="26" TextAlignment="Right" Margin="0,0,7,0"
                           Text="{Binding Count}" />

                <TextBlock Grid.Column="1"
                           FontFamily="Segoe UI" FontSize="11"
                           Foreground="{StaticResource Ink}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Name}"
                           ToolTip="{Binding Reason}" />
            </Grid>
        </DataTemplate>

        <!-- A section: a header you can click to fold it away, and its rows. -->
        <DataTemplate x:Key="ItemSectionTemplate">
            <StackPanel Margin="0,0,0,5">
                <Button Command="{Binding Toggle}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="0,1">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                    <TextBlock FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource Muted}"
                               Text="{Binding Heading}" />
                </Button>

                <ItemsControl ItemsSource="{Binding Rows}"
                              Visibility="{Binding Visibility}"
                              ItemTemplate="{StaticResource ItemRowTemplate}" />
            </StackPanel>
        </DataTemplate>

        <!--
            Controls exist only in interact mode, so they are styled for a moment of deliberate
            fiddling rather than for glanceability. Flat, square, and quiet until hovered.
        -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="#33ffffff"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#668ec8ff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The map, drawn from the game's own map file. Sits behind the readout in both modes. -->
        <Border x:Name="Frame"
                Background="#e60b0f13"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="2">
            <Grid Margin="10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Where you are going, which is the one thing worth reading mid-raid. -->
                <StackPanel x:Name="Readout" Grid.Row="0">
                    <TextBlock x:Name="MapNameText" Style="{StaticResource Label}" Text="RATNAV" />
                    <TextBlock x:Name="NextStopText"
                               FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}"
                               TextTrimming="CharacterEllipsis"
                               Text="No plan" />
                    <TextBlock x:Name="BearingText"
                               FontFamily="Consolas" FontSize="13"
                               Foreground="{StaticResource Accent}" Text="" />
                </StackPanel>

                <!--
                    Map and items side by side. The list is a narrow strip rather than a block
                    under the map, because that is the shape that leaves the map its height — and
                    which side it sits on is the player's call, since the overlay could be against
                    either edge of the screen.
                -->
                <Grid Grid.Row="1" Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftSlot" Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="RightSlot" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="MapFrame" Grid.Column="1"
                            Background="#33141b21"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1">
                        <Canvas x:Name="MapCanvas" ClipToBounds="True" />
                    </Border>

                    <Border x:Name="ItemsPanel" Grid.Column="2" Visibility="Collapsed"
                            Width="152" Margin="6,0,0,0" Padding="6,4"
                            Background="#33141b21" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Button x:Name="SwapSide" Style="{StaticResource Chip}"
                                        HorizontalAlignment="Left" Content="⇄"
                                        ToolTip="Move the list to the other side"
                                        Visibility="Collapsed" />
                                <Button x:Name="DetachItems" Style="{StaticResource Chip}"
                                        HorizontalAlignment="Right" Content="pop out"
                                        Visibility="Collapsed" />
                            </Grid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ItemsList"
                                              ItemTemplate="{StaticResource ItemSectionTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid x:Name="StatusRow" Grid.Row="3">
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Label}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="FixAgeText" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>

        <!--
            The answer to "what is this for?", shown after the identify key is pressed and
            dismissed on the next press or the next fix. Sits over the readout rather than beside
            it: while you are reading this you are standing in your stash, not navigating.
        -->
        <Border x:Name="IdentifyCardPanel" Visibility="Collapsed"
                VerticalAlignment="Top" Margin="8"
                Padding="10,8"
                Background="#f20b0f13"
                BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="2">
            <StackPanel>
                <TextBlock x:Name="IdentifyName"
                           FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="IdentifyHedge" Style="{StaticResource Label}" Margin="0,1,0,0" />

                <ItemsControl x:Name="IdentifyReasons" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas" FontSize="11"
                                       Foreground="{Binding Colour}"
                                       TextWrapping="Wrap"
                                       Margin="0,1"
                                       Text="{Binding Text}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!--
            Interaction furniture, shown only while the overlay accepts the mouse. Hidden the rest
            of the time so nothing decorative sits over the game during a raid.
        -->
        <Grid x:Name="EditChrome" Visibility="Collapsed">
            <Border BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="2" />

            <Border x:Name="DragHandle"
                    Height="22" VerticalAlignment="Top"
                    Background="#cc8ec8ff" CornerRadius="2,2,0,0"
                    Cursor="SizeAll">
                <TextBlock Text="  drag to move  ·  wheel to zoom  ·  corner to resize"
                           FontFamily="Consolas" FontSize="10"
                           Foreground="#0b0f13" VerticalAlignment="Center" />
            </Border>

            <!--
                One row, in the order you reach for things: which level you are looking at, how
                much map to draw, how bright it is, and how far in. Every control writes straight
                to settings, so what you set is what you get next raid.
            -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,10" Padding="8,6"
                    Background="#e60b0f13"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Label}" Text="FLOOR" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="FloorDown" Style="{StaticResource Chip}" Content="▼" />
                    <TextBlock x:Name="FloorText" Style="{StaticResource Label}"
                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                               MinWidth="86" TextAlignment="Center" Text="—" />
                    <Button x:Name="FloorUp" Style="{StaticResource Chip}" Content="▲" />

                    <Rectangle Width="1" Margin="10,2" Fill="{StaticResource Line}" />

                    <TextBlock Style="{StaticResource Label}" Text="INK" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="InkButton" Style="{StaticResource Chip}" Content="structure" MinWidth="66" />

                    <Rectangle Width="1" Margin="10,2" Fill="{StaticResource Line}" />

                    <TextBlock Style="{StaticResource Label}" Text="FADE" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="FadeDown" Style="{StaticResource Chip}" Content="−" />
                    <TextBlock x:Name="FadeText" Style="{StaticResource Label}"
                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                               MinWidth="38" TextAlignment="Center" Text="55%" />
                    <Button x:Name="FadeUp" Style="{StaticResource Chip}" Content="+" />

                    <Rectangle Width="1" Margin="10,2" Fill="{StaticResource Line}" />

                    <TextBlock Style="{StaticResource Label}" Text="ZOOM" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="ZoomReset" Style="{StaticResource Chip}" Content="1.0×" MinWidth="44" />

                    <Rectangle Width="1" Margin="10,2" Fill="{StaticResource Line}" />

                    <TextBlock Style="{StaticResource Label}" Text="MAP" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="FollowButton" Style="{StaticResource Chip}" Content="still" MinWidth="62" />

                    <!-- The crosshair every mapping app has: put it back on me and lock it there. -->
                    <Button x:Name="RecentreButton" Style="{StaticResource Chip}" Content="⌖"
                            ToolTip="Recentre on you and follow again"
                            Visibility="Collapsed" />

                    <Rectangle Width="1" Margin="10,2" Fill="{StaticResource Line}" />

                    <TextBlock Style="{StaticResource Label}" Text="LINE" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="WeightDown" Style="{StaticResource Chip}" Content="−" />
                    <TextBlock x:Name="WeightText" Style="{StaticResource Label}"
                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                               MinWidth="42" TextAlignment="Center" Text="1.00×" />
                    <Button x:Name="WeightUp" Style="{StaticResource Chip}" Content="+" />
                    <Button x:Name="HaloButton" Style="{StaticResource Chip}" Content="halo on"
                            MinWidth="62" Margin="6,0,0,0"
                            ToolTip="A dark edge behind every line, so the map reads on snow and in basements" />

                    <Rectangle Width="1" Margin="10,2" Fill="{StaticResource Line}" />

                    <TextBlock Style="{StaticResource Label}" Text="EXITS" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="ExtractButton" Style="{StaticResource Chip}" Content="pmc" MinWidth="44" />

                    <Rectangle Width="1" Margin="10,2" Fill="{StaticResource Line}" />

                    <Button x:Name="ItemsButton" Style="{StaticResource Chip}" Content="items ▸" MinWidth="62" />
                </StackPanel>
            </Border>

            <Thumb x:Name="ResizeGrip"
                   Width="16" Height="16"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Path Data="M 16,0 L 16,16 L 0,16 Z" Fill="#cc8ec8ff" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Grid>
</Window>
