<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The icon Windows shows for the executable, the taskbar and the installer. Built from
      brand/ratnav-mark.svg by brand/render.ps1 — see brand/README.md before editing it here.
    -->
    <ApplicationIcon>ratnav.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also embedded, so the tray icon can load the real thing rather than a system stand-in. -->
    <Resource Include="ratnav.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RatNav.Core\RatNav.Core.csproj" />
    <ProjectReference Include="..\RatNav.Service\RatNav.Service.csproj" />
  </ItemGroup>

  <!--
    The built web app, linked in from the service that serves it.

    Content from a referenced project reaches this project's *build* output but not its *publish*
    output, so without this the developer build serves every page and the release download 404s on
    all of them — the exact bug, shipped only to strangers. Linked here explicitly so both paths
    carry it.
  -->
  <ItemGroup>
    <Content Include="..\RatNav.Service\wwwroot\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      The Windows 10 target unlocks Windows.Media.Ocr, which reads the item tooltip off the
      screen. It ships with Windows, so identification costs no download, no native binaries, and
      no network — and SupportedOSPlatformVersion keeps the app running on older Windows 10, where
      it simply reports that reading is unavailable.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>

    <!-- What people download and double-click. "RatNav.App.exe" reads like a build artefact. -->
    <AssemblyName>RatNav</AssemblyName>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

    <!--
      A build nobody released says 0.0.0, and the release workflow overrides it with the tag.

      Left alone, .NET stamps 1.0.0 — which is not any RatNav that has ever existed, is newer than
      every real release by every comparison, and had the app reporting "you are on 1.0.0, which is
      the newest release" to anybody running from source. A version that cannot be mistaken for a
      release is the honest default.
    -->
    <Version>0.0.0</Version>
    <InformationalVersion>0.0.0</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The tray icon is WinForms; nothing else here is. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      Per-monitor DPI, set here rather than in the manifest: WinForms warns (WFAC010) when a
      manifest declares it, and this is the setting it honours. A 4K vertical second monitor
      beside a gaming display is exactly the setup this is for.
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

</Project>
