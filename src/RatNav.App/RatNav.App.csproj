<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RatNav.Core\RatNav.Core.csproj" />
    <ProjectReference Include="..\RatNav.Service\RatNav.Service.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The tray icon is WinForms; nothing else here is. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      Per-monitor DPI, set here rather than in the manifest: WinForms warns (WFAC010) when a
      manifest declares it, and this is the setting it honours. A 4K vertical second monitor
      beside a gaming display is exactly the setup this is for.
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

</Project>
